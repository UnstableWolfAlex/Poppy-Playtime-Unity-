name: "Poppy Playtime - WebGL builder & license helper"

# ==================================================================
#  THE ONLY FILE THIS REPO NEEDS.
#  Two modes (pick in the Run workflow dropdown):
#    * build                -> build the game and publish to GitHub Pages
#    * get-activation-file  -> produce Unity_v2022.3.11f1.alf for the
#                              free-license route (README step 5, Route A)
#  A new Release (published) always triggers a build automatically.
#  The game zips live in Releases - this repo never holds them.
# ==================================================================

on:
  workflow_dispatch:
    inputs:
      mode:
        description: "What should this run do?"
        required: true
        default: "build"
        type: choice
        options:
          - build
          - get-activation-file
  release:
    types: [published]

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: poppy-build-and-deploy
  cancel-in-progress: false

jobs:
  activation:
    name: Get Unity activation file (.alf)
    if: ${{ github.event_name == 'workflow_dispatch' && inputs.mode == 'get-activation-file' }}
    runs-on: ubuntu-latest
    steps:
      - name: Create Unity manual activation file (.alf)
        run: |
          # Runs Unity headlessly inside the official game-ci editor image
          # and asks it for a manual activation file (.alf).
          docker run --rm \
            -v "$GITHUB_WORKSPACE":/workspace \
            -w /workspace \
            unityci/editor:ubuntu-2022.3.11f1-webgl-3 \
            unity-editor \
              -batchmode \
              -nographics \
              -logFile /dev/stdout \
              -quit \
              -createManualActivationFile || true

          echo "--- Looking for the .alf file ---"
          ls -la
          ALF=$(find . -maxdepth 2 -name 'Unity_v*.alf' | head -1)
          if [ -z "$ALF" ]; then
            echo "::error::No Unity_v*.alf was produced. Re-run this workflow; if it keeps failing, use the 'Unity Hub' route from the guide (step 5, Route B) instead."
            exit 1
          fi
          echo "Activation file created: $ALF"

      - name: Upload activation file as artifact
        uses: actions/upload-artifact@v4
        with:
          name: Unity_Activation_File
          path: Unity_v*.alf
          if-no-files-found: error
          retention-days: 30

  build:
    name: Build WebGL & deploy to Pages
    if: ${{ github.event_name == 'release' || (github.event_name == 'workflow_dispatch' && inputs.mode == 'build') }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Check Unity license secret exists
        env:
          HAS_LICENSE: ${{ secrets.UNITY_LICENSE != '' }}
          HAS_SERIAL: ${{ secrets.UNITY_SERIAL != '' }}
        run: |
          if [ "$HAS_LICENSE" != "true" ] && [ "$HAS_SERIAL" != "true" ]; then
            echo "::error::UNITY_LICENSE secret is not set yet."
            echo "::error::Run this workflow with mode = get-activation-file first, then follow guide step 5 to create the secrets."
            exit 1
          fi
          echo "License secret found, continuing."

      - name: Download game zips from the release
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_TAG: ${{ github.event.release.tag_name }}
        run: |
          mkdir -p zips
          if [ -n "$RELEASE_TAG" ]; then
            echo "Triggered by release '$RELEASE_TAG' - downloading its assets..."
            gh release download "$RELEASE_TAG" --repo "$GITHUB_REPOSITORY" --pattern '*.zip' --dir zips --clobber
          else
            echo "Manual run - downloading assets from the LATEST release..."
            gh release download --repo "$GITHUB_REPOSITORY" --pattern '*.zip' --dir zips --clobber
          fi
          COUNT=$(ls -1 zips/*.zip 2>/dev/null | wc -l || true)
          if [ "$COUNT" -eq 0 ]; then
            echo "::error::No .zip files found in any release."
            echo "::error::Go to Releases -> 'Draft a new release' -> drag in Poppy-Playtime-Unity-merged.zip (or the 10 poppy_part*.zip) -> Publish. Then run this workflow again."
            exit 1
          fi
          echo "Found $COUNT zip file(s):"
          ls -la zips/

      - name: Extract game project and locate it
        id: detect
        run: |
          mkdir -p extracted
          for z in zips/*.zip; do
            echo "Extracting $z ..."
            unzip -o -q "$z" -d extracted
          done
          PV=$(find extracted -maxdepth 4 -type f -path '*ProjectSettings/ProjectVersion.txt' | head -1)
          if [ -z "$PV" ]; then
            echo "::error::Could not find a Unity project (ProjectSettings/ProjectVersion.txt) inside the zips."
            echo "::error::Make sure you uploaded the correct game archive(s)."
            exit 1
          fi
          PROJECT_DIR="$(dirname "$(dirname "$PV")")"
          echo "Project located at: $PROJECT_DIR"
          echo "project_dir=$PROJECT_DIR" >> "$GITHUB_OUTPUT"

      - name: Write build script and web template into the project
        env:
          PROJECT_DIR: ${{ steps.detect.outputs.project_dir }}
        run: |
          set -e
          mkdir -p "$PROJECT_DIR/Assets/Editor" "$PROJECT_DIR/Assets/WebGLTemplates/PoppyTheme"

          # ---------- Unity headless build script ----------
          cat > "$PROJECT_DIR/Assets/Editor/PPUWebGLBuild.cs" <<'PPU_CS_EOF'
          using System;
          using System.IO;
          using System.Linq;
          using UnityEditor;
          using UnityEditor.Build.Reporting;
          using UnityEngine;

          namespace PPU.Editor
          {
              /// <summary>
              /// Headless WebGL build entry point used by the GitHub Actions workflow
              /// (game-ci/unity-builder, buildMethod: PPU.Editor.PPUWebGLBuild.Build).
              ///
              /// - Builds every enabled scene from Editor Build Settings
              ///   (falls back to "all scenes in the project" if the list is empty)
              /// - Forces Gzip compression (works everywhere with the fetch patch
              ///   baked into the PoppyTheme template)
              /// - Uses the custom "PoppyTheme" WebGL template (dark loading screen)
              /// - Output goes to &lt;project&gt;/build/webgl
              /// </summary>
              public static class PPUWebGLBuild
              {
                  public static void Build()
                  {
                      var projectRoot = Directory.GetParent(Application.dataPath).FullName;
                      var outDir = Path.Combine(projectRoot, "build", "webgl");

                      Debug.Log("[PPU] WebGL build starting. Output: " + outDir);

                      // ---- WebGL player settings ------------------------------------
                      PlayerSettings.WebGL.compressionFormat = WebGLCompressionFormat.Gzip;
                      PlayerSettings.WebGL.decompressionFallback = false; // our template handles gzip in JS

                      try
                      {
                          PlayerSettings.WebGL.template = "PROJECT:PoppyTheme";
                          Debug.Log("[PPU] WebGL template set to PROJECT:PoppyTheme");
                      }
                      catch (Exception e)
                      {
                          Debug.LogWarning("[PPU] Could not select PoppyTheme template, falling back to default. " + e.Message);
                      }

                      // ---- Scenes ----------------------------------------------------
                      var scenes = EditorBuildSettings.scenes
                          .Where(s => s.enabled)
                          .Select(s => s.path)
                          .ToArray();

                      if (scenes == null || scenes.Length == 0)
                      {
                          Debug.LogWarning("[PPU] Editor Build Settings has no enabled scenes - falling back to every scene in the project.");
                          scenes = AssetDatabase.FindAssets("t:Scene")
                              .Select(guid => AssetDatabase.GUIDToAssetPath(guid))
                              .Where(p => !string.IsNullOrEmpty(p))
                              .Distinct()
                              .OrderBy(p => p) // deterministic order; SampleScene sorts before others alphabetically
                              .ToArray();
                      }

                      if (scenes.Length == 0)
                      {
                          Debug.LogError("[PPU] No scenes found in this project - cannot build.");
                          EditorApplication.Exit(1);
                          return;
                      }

                      Debug.Log("[PPU] Scenes in build: " + string.Join(", ", scenes));

                      // ---- Build ------------------------------------------------------
                      var options = new BuildPlayerOptions
                      {
                          scenes = scenes,
                          locationPathName = outDir,
                          target = BuildTarget.WebGL,
                          options = BuildOptions.None
                      };

                      BuildReport report;
                      try
                      {
                          report = BuildPipeline.BuildPlayer(options);
                      }
                      catch (Exception e)
                      {
                          Debug.LogError("[PPU] BuildPlayer threw: " + e);
                          EditorApplication.Exit(1);
                          return;
                      }

                      var summary = report.summary;
                      Debug.Log($"[PPU] Build result: {summary.result} | size: {summary.totalSize / (1024 * 1024)} MB | warnings: {summary.totalWarnings} | errors: {summary.totalErrors}");

                      if (summary.result != BuildResult.Succeeded)
                      {
                          EditorApplication.Exit(1);
                          return;
                      }

                      Debug.Log("[PPU] WebGL build finished successfully.");
                      EditorApplication.Exit(0);
                  }
              }
          }
          PPU_CS_EOF

          # ---------- WebGL template (dark loading screen) ----------
          cat > "$PROJECT_DIR/Assets/WebGLTemplates/PoppyTheme/index.html" <<'PPU_HTML_EOF'
          <!DOCTYPE html>
          <html lang="en">
          <head>
            <meta charset="utf-8">
            <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
            <meta name="theme-color" content="#0d0b10">
            <title>%UNITY_WEBGL_NAME%</title>
            <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='%230d0b10'/%3E%3Ccircle cx='16' cy='16' r='13' fill='none' stroke='%23e5484d' stroke-width='2'/%3E%3Ctext x='16' y='21' font-family='Arial' font-size='13' font-weight='bold' fill='%23e5484d' text-anchor='middle'%3EPPU%3C/text%3E%3C/svg%3E">

            <style>
              :root {
                --bg: #0d0b10;
                --panel: #16131a;
                --red: #e5484d;
                --red-soft: rgba(229, 72, 77, 0.35);
                --blue: #3aa0ff;
                --text: #f2eff4;
                --muted: #8b8492;
              }
              * { margin: 0; padding: 0; box-sizing: border-box; }
              html, body {
                width: 100%; height: 100%;
                background: var(--bg);
                overflow: hidden;
                font-family: ui-sans-serif, system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                color: var(--text);
                -webkit-user-select: none; user-select: none;
              }

              /* ---------- game canvas ---------- */
              #unity-container { width: 100%; height: 100%; position: relative; }
              #unity-canvas {
                width: 100%; height: 100%;
                display: block;
                background: #000;
                outline: none;
              }

              /* ---------- loading overlay ---------- */
              #loading-overlay {
                position: absolute; inset: 0;
                display: flex; flex-direction: column;
                align-items: center; justify-content: center;
                background:
                  radial-gradient(1200px 700px at 50% 35%, rgba(229,72,77,0.10), transparent 60%),
                  repeating-linear-gradient(45deg, rgba(255,255,255,0.012) 0 2px, transparent 2px 18px),
                  var(--bg);
                z-index: 20;
                transition: opacity .8s ease;
              }
              #loading-overlay.done { opacity: 0; pointer-events: none; }

              .lamp {
                width: 12px; height: 12px; border-radius: 50%;
                background: var(--blue);
                box-shadow: 0 0 14px var(--blue);
                margin-bottom: 26px;
                animation: lamp-blink 1.6s ease-in-out infinite;
              }
              @keyframes lamp-blink { 0%,100% { opacity: 1; } 50% { opacity: .25; } }

              .title {
                font-size: clamp(28px, 6vw, 58px);
                font-weight: 900;
                letter-spacing: .30em;
                text-indent: .30em;
                text-transform: uppercase;
                text-shadow: 0 0 26px var(--red-soft), 0 0 60px rgba(229,72,77,0.15);
                animation: glow 3.2s ease-in-out infinite;
                white-space: nowrap;
              }
              @keyframes glow {
                0%, 100% { text-shadow: 0 0 26px var(--red-soft), 0 0 60px rgba(229,72,77,0.15); }
                50%      { text-shadow: 0 0 34px rgba(229,72,77,0.65), 0 0 90px rgba(229,72,77,0.35); }
              }
              .subtitle {
                margin-top: 12px;
                font-size: clamp(11px, 1.6vw, 14px);
                letter-spacing: .52em; text-indent: .52em;
                text-transform: uppercase;
                color: var(--muted);
              }

              .bar-shell { margin-top: 46px; width: min(420px, 72vw); }
              .bar-track {
                height: 10px; border-radius: 999px;
                background: rgba(255,255,255,0.07);
                border: 1px solid rgba(255,255,255,0.08);
                overflow: hidden;
                position: relative;
              }
              .bar-fill {
                height: 100%; width: 0%;
                border-radius: 999px;
                background: linear-gradient(90deg, #a33438, var(--red) 55%, #ff7a7e);
                box-shadow: 0 0 18px var(--red-soft);
                position: relative;
                transition: width .25s ease;
              }
              .bar-fill::after {         /* moving shine */
                content: ""; position: absolute; inset: 0;
                background: linear-gradient(100deg, transparent 20%, rgba(255,255,255,.35) 50%, transparent 80%);
                transform: translateX(-100%);
                animation: shine 1.6s linear infinite;
              }
              @keyframes shine { to { transform: translateX(100%); } }

              .bar-meta {
                display: flex; justify-content: space-between; align-items: baseline;
                margin-top: 12px;
                font-variant-numeric: tabular-nums;
              }
              .phase { font-size: 13px; color: var(--muted); letter-spacing: .06em; }
              .pct   { font-size: 15px; font-weight: 700; color: var(--red); }

              .hint {
                margin-top: 34px; max-width: 460px; text-align: center;
                font-size: 12px; line-height: 1.7; color: var(--muted);
              }
              .hint b { color: #c9c3cf; font-weight: 600; }

              .footer {
                position: absolute; bottom: 14px; left: 0; right: 0;
                text-align: center; font-size: 11px; letter-spacing: .14em;
                color: rgba(139,132,146,.55); text-transform: uppercase;
              }

              /* ---------- fullscreen button ---------- */
              #btn-fullscreen {
                position: absolute; right: 16px; bottom: 16px; z-index: 30;
                width: 44px; height: 44px; border-radius: 10px;
                border: 1px solid rgba(255,255,255,.14);
                background: rgba(13,11,16,.72);
                color: var(--text); cursor: pointer;
                display: flex; align-items: center; justify-content: center;
                backdrop-filter: blur(4px);
                transition: background .15s ease, border-color .15s ease;
              }
              #btn-fullscreen:hover { background: rgba(229,72,77,.22); border-color: var(--red-soft); }
              #btn-fullscreen svg { width: 20px; height: 20px; fill: currentColor; }

              /* ---------- blockers (mobile / error) ---------- */
              .blocker {
                position: fixed; inset: 0; z-index: 50;
                display: none; flex-direction: column;
                align-items: center; justify-content: center;
                text-align: center; padding: 28px;
                background: var(--bg);
              }
              .blocker.show { display: flex; }
              .blocker .big { font-size: 30px; font-weight: 900; letter-spacing: .2em; text-transform: uppercase; margin-top: 22px; }
              .blocker p { margin-top: 14px; max-width: 430px; color: var(--muted); font-size: 14px; line-height: 1.75; }
              .blocker .skull {
                width: 74px; height: 74px; border-radius: 50%;
                border: 3px solid var(--red);
                display: flex; align-items: center; justify-content: center;
                font-size: 30px; font-weight: 900; color: var(--red);
                box-shadow: 0 0 30px var(--red-soft);
              }
              #btn-continue-mobile {
                margin-top: 30px; background: none; border: none;
                color: rgba(139,132,146,.6); font-size: 11px; letter-spacing: .18em;
                text-transform: uppercase; cursor: pointer; text-decoration: underline;
              }
              #btn-continue-mobile:hover { color: var(--muted); }
            </style>

            <script>
            /* =====================================================================
               PATCH 1 - gzip decompression patch
               GitHub Pages serves files as static bytes without the
               "Content-Encoding: gzip" header, so Unity's loader would receive
               compressed bytes it can't read. This patch intercepts every fetch
               of a *.gz / *.br file and decompresses it in the browser with
               DecompressionStream. This is what makes the game work on Pages.
               MUST run before the Unity loader script below.
               ===================================================================== */
            (function () {
              if (!window.fetch) return;
              var originalFetch = window.fetch.bind(window);
              window.fetch = function (input, init) {
                var url = (typeof input === 'string') ? input : (input && input.url) || '';
                var path = String(url).split('?')[0].toLowerCase();
                var enc = null;
                if (/\.gz$/.test(path)) enc = 'gzip';
                else if (/\.br$/.test(path)) enc = 'br';
                if (!enc || !('DecompressionStream' in window)) return originalFetch(input, init);

                return originalFetch(input, init).then(function (resp) {
                  var serverEnc = resp.headers.get('Content-Encoding');
                  if (serverEnc && serverEnc !== 'identity') return resp; // server already handled it
                  var decompressed = resp.body.pipeThrough(new DecompressionStream(enc));
                  var headers = new Headers();
                  resp.headers.forEach(function (v, k) {
                    if (k !== 'content-length' && k !== 'content-encoding') headers.set(k, v);
                  });
                  headers.set('content-encoding', enc);
                  return new Response(decompressed, { status: resp.status, statusText: resp.statusText, headers: headers });
                });
              };
            })();
            </script>
          </head>

          <body>
            <div id="unity-container">
              <canvas id="unity-canvas" tabindex="-1"></canvas>

              <button id="btn-fullscreen" title="Toggle fullscreen" aria-label="Toggle fullscreen">
                <svg viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
              </button>

              <div id="loading-overlay">
                <div class="lamp"></div>
                <div class="title">%UNITY_WEBGL_NAME%</div>
                <div class="subtitle">Unity Fan Edition &mdash; Open Source</div>

                <div class="bar-shell">
                  <div class="bar-track"><div class="bar-fill" id="bar-fill"></div></div>
                  <div class="bar-meta">
                    <span class="phase" id="phase">Warming up the factory&hellip;</span>
                    <span class="pct" id="pct">0%</span>
                  </div>
                </div>

                <div class="hint">
                  <b>First launch downloads the full game</b> &mdash; on a slow connection this can take a while.
                  The screen stays dark until loading finishes, that is normal.<br>
                  Click the game window so the keyboard and mouse work.
                </div>

                <div class="footer">Poppy-Playtime-Unity &middot; built automatically with GitHub Actions</div>
              </div>
            </div>

            <!-- shown on phones / tablets -->
            <div class="blocker" id="mobile-blocker">
              <div class="skull">!</div>
              <div class="big">Grab your PC</div>
              <p>This game needs a <b>desktop browser</b> with WebGL2 (Chrome, Edge or Firefox on Windows / Mac / Linux).
                 It is several hundred megabytes and far too heavy for phones.</p>
              <button id="btn-continue-mobile">load anyway, at my own risk</button>
            </div>

            <!-- shown when WebGL2 is missing -->
            <div class="blocker" id="webgl-blocker">
              <div class="skull">!</div>
              <div class="big">WebGL2 required</div>
              <p>Your browser cannot run this game because WebGL2 is unavailable.
                 Update your browser and make sure <b>hardware acceleration</b> is enabled in its settings.</p>
            </div>

            <script>
            /* PATCH 2 - surface fatal errors on the loading screen */
            window.addEventListener('error', function (e) {
              var phase = document.getElementById('phase');
              if (phase && !document.getElementById('loading-overlay').classList.contains('done')) {
                phase.textContent = 'Error: ' + (e.message || 'unknown failure (check browser console)');
                phase.style.color = '#e5484d';
              }
            });

            /* PATCH 3 - desktop notice for phones */
            (function () {
              var isMobileUA = /Android|iPhone|iPad|iPod|Mobile|Silk/i.test(navigator.userAgent);
              var isCoarse = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
              if (isMobileUA || isCoarse) {
                document.getElementById('mobile-blocker').classList.add('show');
                document.getElementById('btn-continue-mobile').addEventListener('click', function () {
                  document.getElementById('mobile-blocker').classList.remove('show');
                  startGame();
                });
              } else {
                startGame();
              }

              /* PATCH 4 - fullscreen button */
              document.getElementById('btn-fullscreen').addEventListener('click', function () {
                var el = document.getElementById('unity-container');
                if (!document.fullscreenElement) {
                  (el.requestFullscreen || el.webkitRequestFullscreen || function(){}).call(el);
                } else {
                  (document.exitFullscreen || document.webkitExitFullscreen || function(){}).call(document);
                }
              });

              /* the actual Unity bootstrap */
              var started = false;
              function startGame() {
                if (started) return;
                started = true;

                var canvas = document.getElementById('unity-canvas');

                /* WebGL2 availability check */
                var test = document.createElement('canvas');
                var gl = test.getContext('webgl2') || test.getContext('experimental-webgl2');
                if (!gl) {
                  document.getElementById('mobile-blocker').classList.remove('show');
                  document.getElementById('webgl-blocker').classList.add('show');
                  return;
                }

                var buildUrl = 'Build';
                var loaderUrl = buildUrl + '/%UNITY_WEBGL_LOADER_FILENAME%';
                var config = {
                  dataUrl: buildUrl + '/%UNITY_WEBGL_DATA_FILENAME%',
                  frameworkUrl: buildUrl + '/%UNITY_WEBGL_FRAMEWORK_FILENAME%',
                  codeUrl: buildUrl + '/%UNITY_WEBGL_CODE_FILENAME%',
                  streamingAssetsUrl: 'StreamingAssets',
                  companyName: '%UNITY_COMPANY_NAME%',
                  productName: '%UNITY_PRODUCT_NAME%',
                  productVersion: '%UNITY_PRODUCT_VERSION%',
                  showBanner: function (msg, type) {
                    var phase = document.getElementById('phase');
                    if (phase) {
                      phase.textContent = msg;
                      phase.style.color = (type === 'error') ? '#e5484d' : '#8b8492';
                    }
                  }
                };

                var fill = document.getElementById('bar-fill');
                var pct = document.getElementById('pct');
                var phase = document.getElementById('phase');
                var phases = [
                  [0,  'Warming up the factory\u2026'],
                  [8,  'Unpacking crates\u2026'],
                  [30, 'Charging the GrabPack\u2026'],
                  [55, 'Rolling out the conveyor belts\u2026'],
                  [78, 'Somebody is watching\u2026'],
                  [96, 'Starting the engine\u2026']
                ];

                function onProgress(p) {
                  var v = Math.round(p * 100);
                  fill.style.width = v + '%';
                  pct.textContent = v + '%';
                  for (var i = phases.length - 1; i >= 0; i--) {
                    if (v >= phases[i][0]) { phase.textContent = phases[i][1]; break; }
                  }
                }

                onProgress(0);

                var script = document.createElement('script');
                script.src = loaderUrl;
                script.onload = function () {
                  createUnityInstance(canvas, config, onProgress).then(function (instance) {
                    window.unityInstance = instance;
                    var overlay = document.getElementById('loading-overlay');
                    overlay.classList.add('done');
                    setTimeout(function () { overlay.style.display = 'none'; }, 900);
                    canvas.focus();
                  }).catch(function (err) {
                    phase.textContent = 'Startup failed: ' + err;
                    phase.style.color = '#e5484d';
                  });
                };
                script.onerror = function () {
                  phase.textContent = 'Could not download the game loader (network issue?).';
                  phase.style.color = '#e5484d';
                };
                document.body.appendChild(script);
              }
            })();
            </script>
          </body>
          </html>
          PPU_HTML_EOF

          echo "--- Generated CI kit files ---"
          ls -la "$PROJECT_DIR/Assets/Editor/" "$PROJECT_DIR/Assets/WebGLTemplates/PoppyTheme/"

      - name: Cache Unity Library folder (speeds up later builds)
        uses: actions/cache@v4
        with:
          path: ${{ steps.detect.outputs.project_dir }}/Library
          key: Library-WebGL-${{ hashFiles(format('{0}/Packages/manifest.json', steps.detect.outputs.project_dir)) }}
          restore-keys: |
            Library-WebGL-

      - name: Build WebGL with Unity
        uses: game-ci/unity-builder@v4
        env:
          UNITY_LICENSE: ${{ secrets.UNITY_LICENSE }}
          UNITY_EMAIL: ${{ secrets.UNITY_EMAIL }}
          UNITY_PASSWORD: ${{ secrets.UNITY_PASSWORD }}
          UNITY_SERIAL: ${{ secrets.UNITY_SERIAL }}
        with:
          targetPlatform: WebGL
          unityVersion: 2022.3.11f1
          projectPath: ${{ steps.detect.outputs.project_dir }}
          buildName: webgl
          buildMethod: PPU.Editor.PPUWebGLBuild.Build

      - name: Show build output
        run: |
          echo "--- WebGL build files: ---"
          ls -la "${{ steps.detect.outputs.project_dir }}/build/webgl/"
          echo "--- Build/WebGL folder: ---"
          ls -la "${{ steps.detect.outputs.project_dir }}/build/webgl/Build/" | head -20

      - name: Upload build artifact (also usable for itch.io)
        uses: actions/upload-artifact@v4
        with:
          name: webgl-build
          path: ${{ steps.detect.outputs.project_dir }}/build/webgl
          retention-days: 30

  deploy:
    name: Deploy to GitHub Pages
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Download build artifact
        uses: actions/download-artifact@v4
        with:
          name: webgl-build
          path: dist

      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5
        with:
          enablement: true

      - name: Upload Pages artifact
        id: deployment
        uses: actions/upload-pages-artifact@v3
        with:
          path: dist

      - name: Deploy
        uses: actions/deploy-pages@v4
